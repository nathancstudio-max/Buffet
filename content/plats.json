        "en": {
          "etiquette": "Vitality",
          "description": "A lively, fresh and sunny blend, designed to wake up your taste buds from the very first sip. Le Gabin pairs the fruity sweetness of orange and apple with the lightly spicy character of ginger, lifted by the tangy freshness of lemon and the natural sweetness of carrot.",
          "ingredients": "Oranges, carrots, apples, lemons, ginger",
          "pastilles": [
            "250 ml",
            "45 kcal per 100 ml"
          ]
        },
        "es": {
          "etiquette": "Vitalidad",
          "description": "Una composición viva, fresca y soleada, pensada para despertar el paladar desde el primer sorbo. Le Gabin combina la dulzura frutal de la naranja y la manzana con el carácter ligeramente picante del jengibre, realzado por la frescura ácida del limón y la dulzura natural de la zanahoria.",
          "ingredients": "Naranjas, zanahorias, manzanas, limones, jengibre",
          "pastilles": [
            "250 ml",
            "45 kcal por 100 ml"
          ]
        },
        "zh": {
          "etiquette": "活力",
          "description": "这款果汁活泼、清新、充满阳光气息，从第一口起就唤醒您的味蕾。Le Gabin 将橙子与苹果的果香甘甜，同略带辛辣的生姜相融合，再以柠檬的清爽酸味和胡萝卜的天然甜味提升层次。",
          "ingredients": "橙子、胡萝卜、苹果、柠檬、生姜",
          "pastilles": [
            "250毫升",
            "每100毫升 45千卡"
          ]
        },
        "ar": {
          "etiquette": "حيوية",
          "description": "تركيبة نابضة بالحياة ومنعشة ومشرقة، صُمّمت لإيقاظ حاسة التذوق منذ الرشفة الأولى. يجمع «لو غابان» بين حلاوة البرتقال والتفاح الفاكهية ونكهة الزنجبيل الحارة قليلاً، مع انتعاش الليمون الحامض وحلاوة الجزر الطبيعية.",
          "ingredients": "برتقال، جزر، تفاح، ليمون، زنجبيل",
